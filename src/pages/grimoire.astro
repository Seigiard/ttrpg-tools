---
import Layout from '@/layouts/Layout.astro';
---

<Layout title="Grimoire Press · TTRPG Tools" lang="en">
  <div class="grimoire-shell flex flex-col">
    <header class="border-b border-border">
      <div class="flex items-center px-4 py-4 sm:px-6">
        <a
          href="/"
          class="font-mono text-xs uppercase tracking-wider text-text-muted hover:text-primary"
        >
          ← TTRPG Tools
        </a>
      </div>
    </header>

    <main id="grimoire-app" class="grimoire-app min-h-0 flex-1">
      <header class="grimoire-toolbar">
        <strong>Grimoire Press</strong>
        <label><input id="auto-refresh" type="checkbox" checked /> Auto-refresh</label>
        <button id="refresh" type="button">Refresh preview</button>
        <button id="print" type="button">Print</button>
        <button id="download" type="button">Download book</button>
        <label class="grimoire-file-control">
          Load book
          <input id="load" class="sr-only" type="file" accept=".json,application/json" />
        </label>
      </header>
      <div id="editor"></div>
      <div id="preview" role="region" aria-label="Paginated book preview" tabindex="0"></div>
      <div id="status" role="status" aria-live="polite" hidden></div>
    </main>
  </div>

  <script>
    void import('../features/grimoire/main');
  </script>
</Layout>
