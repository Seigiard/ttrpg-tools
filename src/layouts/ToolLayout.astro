---
import Layout from './Layout.astro';

interface Props {
  /** Заголовок инструмента — попадает в <title> и шапку. */
  title: string;
  /** Короткое описание под заголовком. */
  description?: string;
  wide?: boolean;
}

const { title, description, wide = false } = Astro.props;
---

<Layout title={`${title} · TTRPG Tools`}>
  <header
    class:list={['content-grid border-be border-border py-4', { 'content-grid--wide': wide }]}
  >
    <a
      href="/"
      class="inline-flex min-h-11 w-fit items-center font-mono text-xs uppercase tracking-wider text-text-muted hover:text-primary"
    >
      ← TTRPG Tools
    </a>
  </header>

  <main class:list={['content-grid py-tool-block', { 'content-grid--wide': wide }]}>
    <div class="tool-heading">
      <h1 class="font-display text-tool-title text-text">{title}</h1>
      {description ? <p class="max-w-3xl text-text-muted">{description}</p> : null}
    </div>

    <slot />
  </main>

  <div class:list={['content-grid', { 'content-grid--wide': wide }]}>
    <slot name="footer" />
  </div>
</Layout>
