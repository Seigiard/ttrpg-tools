---
interface Props {
  /** Имя автора оригинала. */
  author: string;
  /** Название исходной системы или работы. */
  source: string;
  /** Ссылка на источник. */
  sourceUrl: string;
  /** Текст условий лицензии (короткий). */
  license: string;
  /** Ссылка на полный текст лицензии. */
  licenseUrl: string;
}

const { author, source, sourceUrl, license, licenseUrl } = Astro.props;
---

<footer class="mbs-16 flex flex-col gap-1 border-bs border-border pbs-6 pbe-12 text-sm text-text-muted">
  <p>
    Основано на{' '}
    <a href={sourceUrl} class="underline hover:text-primary">
      {source}
    </a>
    {author}. Распространяется на условиях
    <a href={licenseUrl} class="underline hover:text-primary">
      {license}
    </a>
    .
  </p>
  <p>Перевод и интерфейс — TTRPG Tools.</p>
</footer>
