{
  "name": "ttrpg-tools",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "bun test --parallel=1",
    "test:browser": "playwright test",
    "e2e": "playwright test",
    "measure": "bun scripts/ui-stack/measure.ts",
    "lint": "oxlint src e2e scripts playwright.config.ts",
    "lint:fix": "oxlint --fix src e2e scripts playwright.config.ts",
    "format": "oxfmt src e2e scripts playwright.config.ts && prettier --write 'src/**/*.svelte'",
    "format:check": "oxfmt --check src e2e scripts playwright.config.ts && prettier --check 'src/**/*.svelte'",
    "format:astro": "prettier --write '**/*.astro'",
    "typecheck": "astro check && svelte-check --tsconfig ./tsconfig.json",
    "deploy": "bun run build && bunx wrangler deploy"
  },
  "dependencies": {
    "@astrojs/react": "^7.0.0",
    "@astrojs/svelte": "^9.0.1",
    "@base-ui/react": "^1.8.0",
    "@lucide/svelte": "^1.50.0",
    "@nanostores/react": "^2.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.3.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "lucide-react": "^1.49.0",
    "nanostores": "^1.5.4",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.1",
    "svelte": "^5.57.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@happy-dom/global-registrator": "^20.14.5",
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/svelte": "^5.4.2",
    "@types/bun": "^1.4.2",
    "happy-dom": "^20.14.5",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3"
  }
}
