    "@playwright/test": "^1.64.0",
    "@size-limit/file": "^14.2.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.2",
    "happy-dom": "^20.14.6",
    "lefthook": "^2.2.1",
    "oxfmt": "^0.72.0",
    "oxlint": "1.86.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.1",
    "size-limit": "^14.2.0",
    "typescript": "^6.0.3"
  }
