{
  "name": "ttrpg-tools",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "size": "bun run build && bun run size:check",
    "size:check": "size-limit",
    "preview": "astro preview",
    "astro": "astro",
    "test": "bun test",
    "test:browser": "playwright test",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "format": "oxfmt --ignore-path .gitignore src",
    "format:check": "oxfmt --check --ignore-path .gitignore src",
    "format:astro": "prettier --write '**/*.astro'",
    "typecheck": "astro check",
    "deploy": "bun run build && bunx wrangler deploy",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@astrojs/react": "^7.0.1",
    "@base-ui/react": "^1.9.0",
    "@nanostores/react": "^2.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.3.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "lucide-react": "^1.54.0",
    "nanostores": "^1.5.5",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.4",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
